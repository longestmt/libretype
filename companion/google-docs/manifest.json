{
  "manifest_version": 3,
  "name": "LibreType for Google Docs",
  "version": "0.1.6",
  "description": "Optional setup and caret companion for Google Docs. Completions stay in LibreType\u2019s local Rust engine.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://docs.google.com/document/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "setup.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "LibreType for Google Docs",
    "default_popup": "popup.html"
  }
}
